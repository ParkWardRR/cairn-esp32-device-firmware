{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cairn:engine:v1-draft",
  "title": "Cairn engine profile (YAML), DRAFT",
  "$comment": "DRAFT AND PROVISIONAL. contracts/engine/v1 (ParkWardRR/cairn-driving-log-selfhosted#20) is not released, so this schema lives next to the profiles it describes. It should move into that contract, with engines/vectors as its valid and negative vectors and engines/SPEC.draft.md as its normative text. JSON Schema states structure only; the generator (tools/enginegen) also enforces what a schema cannot: engine_id equals the file name, formulas compile, formula results fit the declared range, PIDs and cold slots are unique, a stub claims nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine_id", "version", "name", "status", "sources", "applies_to", "fuel", "obd", "pids", "cadence", "wake_sleep", "supply"],
  "properties": {
    "schema": { "const": "cairn.engine/v1-draft" },
    "engine_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 31 },
    "version": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "name": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["stub", "derived", "verified"],
      "$comment": "stub: identity only, claims nothing. derived: extracted from behaviour the firmware already had. verified: checked against raw ECU replies from the car."
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make", "models", "years", "vin_patterns"],
      "properties": {
        "make": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "years": { "$ref": "#/$defs/maybe_years" },
        "vin_patterns": {
          "anyOf": [
            { "$ref": "#/$defs/unknown" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-HJ-NPR-Z0-9?]{17}$" } }
          ]
        }
      }
    },
    "fuel": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blend"],
          "properties": {
            "type": { "enum": ["gasoline", "diesel", "hybrid"] },
            "blend": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "string" }] }
          }
        }
      ]
    },
    "obd": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bus", "bitrate_kbps", "addressing"],
          "properties": {
            "bus": { "type": "string", "minLength": 1 },
            "bitrate_kbps": { "type": "integer", "minimum": 1 },
            "addressing": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "string" }] }
          }
        }
      ]
    },
    "pids": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pid" } }
      ]
    },
    "cadence": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["obd_period_ms", "obd_batch_period_ms", "cold_slots"],
          "properties": {
            "obd_period_ms": { "$ref": "#/$defs/maybe_u16_positive" },
            "obd_batch_period_ms": { "$ref": "#/$defs/maybe_u16_positive" },
            "cold_slots": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "integer", "minimum": 1, "maximum": 32 }] },
            "measured": {
              "type": "object",
              "additionalProperties": false,
              "required": ["single_request_ms", "batch_6pid_ms"],
              "properties": {
                "single_request_ms": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
                "batch_6pid_ms": { "type": "integer", "minimum": 0, "maximum": 65535 }
              }
            }
          }
        }
      ]
    },
    "wake_sleep": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_on_mv", "standby_idle_ms", "standby_heartbeat_ms", "drive_voltage_dwell_ms", "drive_motion_dwell_ms", "drive_both_dwell_ms", "bus_first_sleep_phase_ms"],
          "properties": {
            "engine_on_mv": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "integer", "minimum": 1000, "maximum": 65000 }] },
            "standby_idle_ms": { "$ref": "#/$defs/maybe_ms" },
            "standby_heartbeat_ms": { "$ref": "#/$defs/maybe_ms" },
            "drive_voltage_dwell_ms": { "$ref": "#/$defs/maybe_ms" },
            "drive_motion_dwell_ms": { "$ref": "#/$defs/maybe_ms" },
            "drive_both_dwell_ms": { "$ref": "#/$defs/maybe_ms" },
            "bus_first_sleep_phase_ms": { "$ref": "#/$defs/maybe_ms" }
          }
        }
      ]
    },
    "supply": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plausible_mv"],
          "properties": {
            "plausible_mv": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "$ref": "#/$defs/mv_pair" }] },
            "alternator_measured_mv": { "$ref": "#/$defs/mv_pair" }
          }
        }
      ]
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "std_bytes"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 255 },
          "name": { "type": "string", "minLength": 1 },
          "std_bytes": { "type": "integer", "minimum": 1, "maximum": 7 }
        }
      }
    }
  },
  "$defs": {
    "unknown": { "const": "unknown", "$comment": "An explicit statement that nothing is claimed. Distinct from omitting the key, which is invalid." },
    "maybe_years": {
      "anyOf": [
        { "$ref": "#/$defs/unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": { "from": { "type": "integer", "minimum": 1980 }, "to": { "type": "integer", "minimum": 1980 } }
        }
      ]
    },
    "maybe_u16_positive": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] },
    "maybe_ms": { "anyOf": [{ "$ref": "#/$defs/unknown" }, { "type": "integer", "minimum": 1, "maximum": 4294967295 }] },
    "mv_pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
    "pid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "field", "unit", "bytes", "tier", "formula", "range", "log"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "service": { "enum": [1, 34], "default": 1, "$comment": "0x01 and 0x22 (manufacturer-specific); only Mode 01 PIDs can be hot." },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "field": {
          "enum": ["rpm", "speed_kph", "throttle_pct", "timing_advance_deg", "map_kpa", "lambda_e4", "engine_load_pct", "coolant_temp_c", "intake_temp_c", "maf_cgps", "ambient_temp_c", "fuel_trim_short_pct", "fuel_trim_long_pct", "baro_kpa", "abs_load_raw", "fuel_level_pct"],
          "$comment": "The capture-record field the stored value feeds. One PID per field."
        },
        "unit": { "type": "string", "minLength": 1 },
        "scale": { "type": "integer", "minimum": -9, "maximum": 9, "default": 0, "$comment": "decimal exponent: stored integer x 10^scale is the physical value" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 4 },
        "tier": { "enum": ["hot", "cold"], "$comment": "hot: in the multi-PID batch every cycle (at most six, Mode 01). cold: one request, on its turn in the cold rotation." },
        "cold_slot": { "type": "integer", "minimum": 0, "maximum": 31 },
        "formula": { "type": "string", "maxLength": 256, "pattern": "^[A-Da-z0-9_ ()+\\-*/%&|<>,xX]+$", "$comment": "The expression language of engines/SPEC.draft.md. Yields the value exactly as the record stores it." },
        "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" }, "$comment": "[min, max] the formula can produce. The generator proves the formula stays inside it." },
        "log": { "type": "boolean" }
      },
      "if": { "properties": { "tier": { "const": "cold" } } },
      "then": { "required": ["cold_slot"] },
      "else": { "not": { "required": ["cold_slot"] } }
    }
  }
}
